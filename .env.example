# Every value here has a working default. Copy to .env only to change something.

# dev accepts a camera feed whose host permits crawling, which is enough for local
# research. prod accepts only an explicit authorisation or an owner attestation.
PARKFIT_ENVIRONMENT=dev

# Leave unset for SQLite in ./data. Point it at PostgreSQL and the dialect layer switches
# automatically; nothing else in the application needs to know which engine it is on.
# PARKFIT_DATABASE_URL=postgresql+asyncpg://parkfit:parkfit@127.0.0.1:5432/parkfit

# Unset means the native A* router over the cached OSM graph. Set it and OSRM takes
# priority, with the native router still there as the fallback beneath it.
# PARKFIT_OSRM_URL=http://127.0.0.1:5000

# Change this before anything is exposed beyond localhost.
# PARKFIT_JWT_SECRET=generate-a-long-random-value-for-production

# Socrata throttles anonymous clients. A free token raises the limit considerably.
# PARKFIT_RDW_APP_TOKEN=

# How often each camera is sampled. Parking changes over minutes, and slow sampling is a
# privacy control as much as a performance one: it reduces how much imagery of a public
# street exists at any moment.
# PARKFIT_CAMERA_FRAME_INTERVAL_S=8

# An observation older than this is never presented as live.
# PARKFIT_STALE_AFTER_S=300

# Off by default. Setting it to false makes the camera registry refuse a feed that is
# merely crawlable, even in dev.
# PARKFIT_CAMERA_ALLOW_ROBOTS_OK=true
